SECRET_KEY=django-insecure-smart-university-timetable-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set to 'mysql' for MySQL 8.x (spec requirement) or 'sqlite' for quick local fallback
DB_ENGINE=mysql
DB_NAME=smart_timetable
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Channels & Redis
USE_INMEMORY_CHANNELS=True
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

